[node name="Hint" type="Label" parent="HUD"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 70.0
offset_right = 300.0
offset_bottom = 130.0
grow_horizontal = 2
horizontal_alignment = 1
text = "Hold Up to push (hold Ollie or Grab to crouch and push harder), Down to brake or turn sharp. Hold Ollie and let go to pop; Flip or Grab in the air with a direction for the trick, Left/Right to spin. Hold Grind over the ledge, the bench or the handrail and balance with Left/Right; hold it going up past a coping for a lip trick (balance with Up/Down, Ollie out; Up held jumps onto the deck). Tap Up then Down for a manual. Hold Grind into the concrete wall to ride it; press Ollie as you hit it square for a wallplant. Hold Revert rising on the spine to transfer, or in the air off a deck to acid drop. Hold Up behind the truck to skitch, balance with Left/Right, Down or Ollie to let go. Land clean to bank the combo; Revert on a vert landing to keep it. K gets off with the board in hand and back on."
autowrap_mode = 3

